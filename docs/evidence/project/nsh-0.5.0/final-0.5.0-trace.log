   Text { id: 435, text: "Keys keep the state", content: 261x17 @ 0,0 }
   Text { id: 439, text: "Identity is a domain id, never a position and never a generated value.", content: 261x29 @ 0,0 }
   Text { id: 443, text: "Barbara Liskov", content: 261x15 @ 0,0 }
   Text { id: 447, text: "1 comment", content: 261x15 @ 0,0 }
   Text { id: 453, text: "♡ 26", content: 27x15 @ 0,0 }
   Text { id: 461, text: "The offline banner", content: 261x17 @ 0,0 }
   Text { id: 465, text: "Gray the feed, say why, and fail the writes fast so the UI can say so too.", content: 261x29 @ 0,0 }
   Text { id: 469, text: "Alan Kay", content: 261x15 @ 0,0 }
   Text { id: 473, text: "No comments yet", content: 261x15 @ 0,0 }
   Text { id: 479, text: "♡ 19", content: 27x15 @ 0,0 }
   Text { id: 487, text: "Latency you can hold", content: 261x17 @ 0,0 }
   Text { id: 491, text: "Two hundred milliseconds is enough to see every state a screen can be in.", content: 261x29 @ 0,0 }
   Text { id: 495, text: "Grace Hopper", content: 261x15 @ 0,0 }
   Text { id: 499, text: "3 comments", content: 261x15 @ 0,0 }
   Text { id: 505, text: "♡ 12", content: 27x15 @ 0,0 }
   Text { id: 513, text: "A tracer's notebook", content: 268x17 @ 0,0 }
   Text { id: 517, text: "Mount items are the honest number: deterministic, small, and easy to defend.", content: 268x29 @ 0,0 }
   Text { id: 521, text: "Ada Lovelace", content: 268x15 @ 0,0 }
   Text { id: 525, text: "2 comments", content: 268x15 @ 0,0 }
   Text { id: 531, text: "♡ 5", content: 20x15 @ 0,0 }
   Text { id: 539, text: "Optimistic hearts", content: 261x17 @ 0,0 }
   Text { id: 543, text: "Show the like at once, take it back if the write fails, and never block the tap.", content: 261x29 @ 0,0 }
   Text { id: 547, text: "Margaret Hamilton", content: 261x15 @ 0,0 }
   Text { id: 551, text: "1 comment", content: 261x15 @ 0,0 }
   Text { id: 557, text: "♥ 38", content: 27x15 @ 0,0 }
   Text { id: 565, text: "Pull to refresh, properly", content: 261x17 @ 0,0 }
   Text { id: 569, text: "The spinner is the platform's; the state is one bool the app owns.", content: 261x29 @ 0,0 }
   Text { id: 573, text: "Dennis Ritchie", content: 261x15 @ 0,0 }
   Text { id: 577, text: "No comments yet", content: 261x15 @ 0,0 }
   Text { id: 583, text: "♡ 31", content: 27x15 @ 0,0 }
   Text { id: 591, text: "The five-minute query", content: 261x17 @ 0,0 }
   Text { id: 595, text: "Serve yesterday's answer while today's is on its way, and nobody watches a spinner.", content: 261x29 @ 0,0 }
