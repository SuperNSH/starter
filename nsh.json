{
  "name": "nsh-starter",
  "id": "com.example.nshstarter",
  "version": "1.0.0",
  "build": 1,
  "icon": "assets/icon.png",
  "appearance": "system",
  "theme": "themes/theme.json",
  "rust": ".",
  "root": "App",
  "capabilities": {
    "windows": true,
    "application": true,
    "clipboard": true,
    "picker": true,
    "speech": true,
    "notifications": true,
    "webview": { "hosts": [] }
  },
  "schemes": ["nsh-starter"],
  "dependencies": {
    "nsh-extra": {
      "version": "^0.7.1",
      "features": ["speech"]
    }
  }
}
